#!/usr/bin/env ruby
require "fileutils"
require "playwright"

APP_ROOT = File.expand_path("..", __dir__)
APP_NAME = "yournaling".freeze

def system!(*)
  system(*, exception: true)
end

ENV["GEM_HOME"] ||= Gem.paths.home if defined?(Gem)
ENV["GEM_PATH"] ||= Gem.paths.path.join(":") if defined?(Gem)

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # Modern JS toolchain (Bun) for UI tools and Playwright browser tests.
  # Does not touch importmap / Propshaft / production runtime.
  if system("bun --version", out: File::NULL, err: File::NULL)
    puts "== Installing JS dependencies with Bun =="
    system! "bun install"

    playwright_version = Playwright::COMPATIBLE_PLAYWRIGHT_VERSION.strip
    puts "== Aligning Playwright browser driver to version #{playwright_version} =="
    system! "bun add -d playwright@#{playwright_version}"
    system! "bunx playwright install --with-deps chromium"
  else
    puts "!! Bun not found — skipping toolchain setup."
    puts "   `bin/css_lint`, `rake ci`, and RSpec system tests require it."
    puts "   Please install Bun (https://bun.sh) to proceed."
  end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")
  system! "bin/rake", "parallel:setup[4]"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    $stdout.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
