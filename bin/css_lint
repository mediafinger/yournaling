#!/usr/bin/env bash
# Lint + format-check the hand-authored CSS design system.
# Mirrors the bin/mcp_* convention.
#
#   bin/css_lint          lint + format-check (read-only)
#   bin/css_lint -a       auto-correct (stylelint --fix + prettier --write)
#   bin/css_lint autocorrect   same as -a

# A personal BASH_ENV (e.g. ~/.bash_antigravity that auto-switches chruby) is
# re-sourced by every child bash — the asdf `node` shim included — and under
# `bundle exec` chruby then floods stderr with Bundler warnings. This script is
# pure Node; unset it so nothing it spawns re-runs that setup.
unset BASH_ENV

set -eo pipefail

cd "$(dirname "$0")/.."

autocorrect=""
case "${1:-}" in
  -a | autocorrect) autocorrect=1 ;;
  "") ;;
  *)
    echo "usage: bin/css_lint [-a|autocorrect]" >&2
    exit 64
    ;;
esac

if [ ! -x node_modules/.bin/stylelint ]; then
  echo "node_modules missing — run 'npm ci' (or 'npm install') first." >&2
  exit 1
fi

CSS_GLOB="app/assets/stylesheets/design/**/*.css"

if [ -n "$autocorrect" ]; then
  echo "stylelint --fix ${CSS_GLOB}"
  node_modules/.bin/stylelint --fix "${CSS_GLOB}" || true

  echo "prettier --write ${CSS_GLOB}"
  node_modules/.bin/prettier --write "${CSS_GLOB}"
else
  echo "stylelint ${CSS_GLOB}"
  node_modules/.bin/stylelint "${CSS_GLOB}"

  echo "prettier --check ${CSS_GLOB}"
  node_modules/.bin/prettier --check "${CSS_GLOB}"
fi
