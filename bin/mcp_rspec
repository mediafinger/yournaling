#!/usr/bin/env bash
source /opt/homebrew/share/chruby/chruby.sh
chruby $(cat .ruby-version 2>/dev/null)
export PARALLEL_TEST_PROCESSORS="${PARALLEL_TEST_PROCESSORS:-4}"

if [ $# -eq 0 ]; then
  exec bundle exec parallel_rspec -n 4 spec/
elif [ $# -eq 1 ] && [[ "$1" == *":"* || ( -f "$1" && "$1" == *_spec.rb ) ]]; then
  exec bundle exec rspec "$@"
else
  exec bundle exec parallel_rspec -n 4 "$@"
fi
