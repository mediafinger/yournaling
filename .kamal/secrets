#   KAMAL_REGISTRY_PASSWORD RAILS_SECRET_KEY_BASE YOURNALING_DB_PASSWORD \
#   POSTGRES_PASSWORD AMAZON_S3_ACCESS_KEY_ID AMAZON_S3_SECRET_ACCESS_KEY \
#   GEOAPIFY_API_KEY)
#
# KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $SECRETS)
# RAILS_SECRET_KEY_BASE=$(kamal secrets extract RAILS_SECRET_KEY_BASE $SECRETS)
# YOURNALING_DB_PASSWORD=$(kamal secrets extract YOURNALING_DB_PASSWORD $SECRETS)
# POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD $SECRETS)
# AMAZON_S3_ACCESS_KEY_ID=$(kamal secrets extract AMAZON_S3_ACCESS_KEY_ID $SECRETS)
# AMAZON_S3_SECRET_ACCESS_KEY=$(kamal secrets extract AMAZON_S3_SECRET_ACCESS_KEY $SECRETS)
# GEOAPIFY_API_KEY=$(kamal secrets extract GEOAPIFY_API_KEY $SECRETS)

# --- Plain ENV (GitHub Actions / manual export) ------------------------------
KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_SECRET_KEY_BASE=$RAILS_SECRET_KEY_BASE
YOURNALING_DB_PASSWORD=$YOURNALING_DB_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
AMAZON_S3_ACCESS_KEY_ID=$AMAZON_S3_ACCESS_KEY_ID
AMAZON_S3_SECRET_ACCESS_KEY=$AMAZON_S3_SECRET_ACCESS_KEY
GEOAPIFY_API_KEY=$GEOAPIFY_API_KEY
