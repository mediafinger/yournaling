# frozen_string_literal: true

ActiveRecordDoctor.configure do
  # Global settings affect all detectors.
  # Ignore internal Rails-related tables.
  global :ignore_tables, %w[
    active_storage_attachments
    active_storage_blobs
    active_storage_variant_records
    action_text_rich_texts
    ahoy_visits
    ar_internal_metadata
    blazer_audits
    blazer_checks
    blazer_dashboards
    blazer_dashboard_queries
    blazer_queries
    pg_search_documents
    schema_migrations
    solid_cable_messages
    solid_cache_entries
    solid_queue_blocked_executions
    solid_queue_claimed_executions
    solid_queue_failed_executions
    solid_queue_jobs
    solid_queue_pauses
    solid_queue_processes
    solid_queue_ready_executions
    solid_queue_recurring_executions
    solid_queue_recurring_tasks
    solid_queue_scheduled_executions
    solid_queue_semaphores
  ]

  global :ignore_models, %w[
    ActiveStorage::Attachment
    ActiveStorage::Blob
    ActiveStorage::Record
    ActiveStorage::VariantRecord
    Ahoy::Visit
    ApplicationRecord
    Blazer::Audit
    Blazer::Check
    Blazer::Dashboard
    Blazer::DashboardQuery
    Blazer::Query
    Blazer::Upload
    PaperTrail::Version
    PgSearch::Document
    SolidCable::Message
    SolidCache::Entry
    SolidQueue::BlockedExecution
    SolidQueue::ClaimedExecution
    SolidQueue::FailedExecution
    SolidQueue::Job
    SolidQueue::Pause
    SolidQueue::Process
    SolidQueue::ReadyExecution
    SolidQueue::RecurringExecution
    SolidQueue::RecurringTask
    SolidQueue::ScheduledExecution
    SolidQueue::Semaphore
  ]

  # app only validation sufficient, no need to enforce length in DB
  detector :incorrect_length_validation, ignore_attributes: %w[
    Chronicle.id
    Chronicle.name
    Chronicle.notice
    ChronicleEntry.id
    Memory.memo
    Picture.name
    Picture.id
    Team.name
    Team.id
    Thought.text
    User.email
    User.name
    User.nickname
    User.password_digest
    User.id
    User.temp_auth_token
  ]

  detector :missing_foreign_keys, ignore_associations: %w[
    Ahoy::Visit.user
    Login.device
    RecordEvent.team
    RecordEvent.user
    RecordEvent.visit
  ]

  detector :missing_non_null_constraint, ignore_columns: %w[]

  detector :missing_presence_validation, ignore_attributes: %w[
    Location.geocoded_address
  ]

  detector :short_primary_key_type, ignore_tables: %w[
    members
    pictures
    teams
    users
  ]

  detector :undefined_table_references, ignore_models: %w[
    ApplicationRecordYidEnabled
  ]

  detector :unindexed_foreign_keys, ignore_columns: %w[
    logins.device_id
    memories.location_id
    memories.picture_id
    memories.thought_id
    memories.weblink_id
    record_events.record_id
    record_events.record_type
    record_events.team_id
    record_events.user_id
  ]
end
