.yui-cluster.yui-cluster--lg
  - Yui::IconComponent::PATHS.each_key do |name|
    .yui-stack.yui-stack--xs style="align-items: center; width: 5rem"
      = render(Yui::IconComponent.new(name, size: :lg))
      span.yui-text--sm.yui-text--muted style="font-family: var(--yui-font-mono); font-size: var(--yui-text-xs)"
        = name
