= render(Yui::TabsComponent.new(label: "Location", active: 0)) do |tabs|
  - tabs.with_panel(title: "Address") do
    p.ex-text Street, city and country fields go here.
  - tabs.with_panel(title: "GPS Coordinates") do
    p.ex-text Latitude / longitude fields go here.
  - tabs.with_panel(title: "Map / Web URL") do
    p.ex-text A single URL field goes here.
