= render(Yui::TabsComponent.new(label: "Location", active: active.to_i)) do |tabs|
  - tabs.with_panel(title: "Address") do
    p.yui-text Street, city and country fields go here.
  - tabs.with_panel(title: "GPS Coordinates") do
    p.yui-text Latitude / longitude fields go here.
  - tabs.with_panel(title: "Map / Web URL") do
    p.yui-text A single URL field goes here.
