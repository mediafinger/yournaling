= render(Yui::CardComponent.new(variant: :elevated)) do |card|
  - card.with_header do
    = render(Yui::HeadlineComponent.new("Northern beach", level: 4, eyebrow: "Memory"))
  p.ex-text.ex-text--sm The tide took the rest.
