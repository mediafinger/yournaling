{
  "extends": ["stylelint-config-standard", "stylelint-config-recess-order"],
  "ignoreFiles": [
    "node_modules/**",
    "app/assets/builds/**",
    "app/assets/stylesheets/admin.css",
    "app/assets/stylesheets/application.css",
    "app/assets/stylesheets/buttons.css",
    "app/assets/stylesheets/card.css",
    "app/assets/stylesheets/general.css",
    "app/assets/stylesheets/lightbox.css",
    "app/assets/stylesheets/navbar.css",
    "app/assets/stylesheets/pico.*.css",
    "app/assets/stylesheets/picocss_reset.css",
    "app/assets/stylesheets/rails_reset.css"
  ],
  "rules": {
    "custom-property-pattern": "^(ex|yui)-[a-z0-9]+(-[a-z0-9]+)*$|^_[a-z0-9]+$",
    "selector-class-pattern": [
      "^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
      {
        "message": "Expected class selector to be BEM kebab-case (block__element--modifier)"
      }
    ],
    "value-keyword-case": ["lower", { "ignoreProperties": ["/font/"] }],
    "no-descending-specificity": null,
    "declaration-block-no-redundant-longhand-properties": null
  }
}
