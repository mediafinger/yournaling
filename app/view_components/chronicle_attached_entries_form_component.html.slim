- if @chronicle.entries.any?
  fieldset.yui-attached-entries
    legend.yui-attached-entries__legend
      h4.yui-h4 Attached Entries
      p.yui-text.yui-text--sm.yui-text--muted
        | Check "Remove" to detach an entry from this chronicle upon saving. Use "Edit" to modify the insight itself.

    .yui-attached-entries__list data-controller="sortable" data-action="dragover->sortable#dragover"
      = @form.fields_for :entries, builder: ActionView::Helpers::FormBuilder do |entry_form|
        - c_entry = entry_form.object
        - target = c_entry.entry
        - next if target.blank?

        .yui-attached-entry id=dom_id(c_entry) data-sortable-target="item" draggable="true" data-action="dragstart->sortable#dragstart dragend->sortable#dragend"
          = entry_form.hidden_field :id
          = entry_form.hidden_field :position, data: { sortable_target: "position" }

          .yui-attached-entry__main
            span.yui-attached-entry__handle data-sortable-target="handle" title="Drag to reorder" ⠿

            .yui-attached-entry__nudge
              button.yui-btn.yui-btn--ghost.yui-btn--sm type="button" data-sortable-target="upButton" data-action="click->sortable#moveUp" title="Move up" ▲
              button.yui-btn.yui-btn--ghost.yui-btn--sm type="button" data-sortable-target="downButton" data-action="click->sortable#moveDown" title="Move down" ▼

            - case c_entry.entry_type
            - when "Picture"
              img.yui-attached-entry__thumb src=rails_representation_path(target.thumbnail) alt=target.name
              .yui-attached-entry__body
                strong.yui-attached-entry__title = entry_display_title(target)
                small.yui-attached-entry__note = "Picture #{target.date}"
            - when "Location"
              .yui-attached-entry__body
                strong.yui-attached-entry__title = entry_display_title(target)
                - if target.address.present?
                  small.yui-attached-entry__note = target.address
                small.yui-attached-entry__note Location
            - when "Thought"
              .yui-attached-entry__body
                em.yui-attached-entry__note = "“#{target.text.truncate(90)}”#{team_suffix(target)}"
                small.yui-attached-entry__note Thought
            - when "Weblink"
              .yui-attached-entry__body
                strong.yui-attached-entry__title = entry_display_title(target)
                small.yui-attached-entry__note = target.url
                small.yui-attached-entry__note Weblink
            - when "Memory"
              .yui-attached-entry__body
                em.yui-attached-entry__note = "#{target.memo.truncate(90)}#{team_suffix(target)}"
                small.yui-attached-entry__note Memory

          .yui-attached-entry__actions
            - if (edit_path = entry_edit_path(c_entry.entry_type, target))
              = link_to "Edit", edit_path, target: "_blank", rel: "noopener noreferrer", class: "yui-btn yui-btn--secondary yui-btn--sm"

            label.yui-attached-entry__remove
              = entry_form.check_box :_destroy
              | Remove
