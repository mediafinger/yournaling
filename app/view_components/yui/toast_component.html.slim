.yui-toast(class=css_class role=(variant == :danger ? "alert" : "status") aria-live=(variant == :danger ? "assertive" : "polite")
  data-controller="yui-toast" data-yui-toast-delay-value=delay)
  .yui-toast__icon
    = render Yui::IconComponent.new(ICONS.fetch(variant), size: :sm)
  p.yui-toast__body = message
  button.yui-toast__dismiss type="button" aria-label="Dismiss" data-action="yui-toast#dismiss"
    = render Yui::IconComponent.new("x", size: :sm)
