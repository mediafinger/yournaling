= render(Yui::CardComponent.new(variant: :elevated, accent: "accent", interactive: href.present?, class: "ex-chronicle-card")) do |card|
  - if cover
    - card.with_media do
      .ex-chronicle-card__cover
        = image_tag(cover, alt: "", loading: "lazy")

  - card.with_header do
    .ex-stack.ex-stack--sm
      .ex-cluster.ex-cluster--between
        = render(Yui::EyebrowComponent.new("Chronicle"))
        = render(Yui::BadgeComponent.new(visibility[:label], variant: visibility[:variant], icon: visibility[:icon]))
      = render(Yui::HeadlineComponent.new(level: 3)) { href ? link_to(title, href, class: "ex-link ex-link--cover") : title }
      span.ex-chronicle-card__dates
        = render(Yui::IconComponent.new("calendar", size: :sm))
        = date_range

  .ex-stack.ex-stack--sm
    p.ex-chronicle-card__summary = summary

    - if entries.any?
      .ex-timeline
        - entries.first(4).each do |entry|
          .ex-timeline__item
            span.ex-timeline__date = entry[:date]
            div.ex-timeline__title = entry[:title]

  - card.with_footer do
    .ex-cluster.ex-cluster--between style="width: 100%"
      .ex-meta
        = render(Yui::AvatarComponent.new(name: author, size: :sm))
        strong = author
        span.ex-meta__sep
        span = team
      .ex-cluster.ex-cluster--sm
        = render(Yui::BadgeComponent.new("#{memory_count} memories", variant: :gold))
        - if href
          = render(Yui::LinkComponent.new("Open", href: href, variant: :standalone))
