= render(Yui::CardComponent.new(variant: :default, accent: "gold", href: href, class: "ex-memory-card")) do |card|
  - if image
    - card.with_media do
      div style="aspect-ratio: 3 / 2"
        = image_tag(image, alt: "", loading: "lazy")

  - card.with_header do
    .ex-cluster.ex-cluster--between
      .ex-cluster.ex-cluster--sm
        = render(Yui::IconComponent.new("feather", size: :sm))
        span.ex-badge Memory
      = render(Yui::BadgeComponent.new(visibility[:label], variant: visibility[:variant], icon: visibility[:icon]))

  p.ex-memory-card__memo = memo

  - if thought
    p.ex-memory-card__quote = thought

  - if location || tags.any?
    .ex-cluster.ex-cluster--sm
      - if location
        = render(Yui::TagComponent.new(location, icon: "map-pin"))
      - tags.each do |tag|
        = render(Yui::TagComponent.new(tag))

  - card.with_footer do
    .ex-cluster.ex-cluster--between style="width: 100%"
      .ex-meta
        = render(Yui::AvatarComponent.new(name: author, size: :sm))
        strong = author
        span.ex-meta__sep
        span = team
      .ex-meta
        = render(Yui::IconComponent.new("calendar", size: :sm))
        span = on
