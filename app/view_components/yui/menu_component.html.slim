details.yui-menu(class=("yui-menu--end" if align == :end) data-controller="yui-menu")
  summary class=summary_class data-yui-menu-target="trigger"
    - if trigger
      = trigger
    - else
      = label
      = render Yui::IconComponent.new("chevron-down", size: :sm)
  .yui-menu__panel(role="menu" data-yui-menu-target="panel" aria-labelledby=label_id data-action="click->yui-menu#choose")
    = content
