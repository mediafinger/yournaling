.ex-field class=("ex-field--invalid" if invalid?)
  = render(Example::LabelComponent.new(label, for: field_id, required: required))

  - if kind == :textarea
    textarea.ex-textarea(id=field_id name=name rows=rows placeholder=placeholder
      required=required disabled=disabled aria-describedby=described_by aria-invalid=aria_invalid)
      = value

  - elsif kind == :select
    .ex-select-wrap
      select.ex-select(id=field_id name=name required=required disabled=disabled
        aria-describedby=described_by aria-invalid=aria_invalid)
        - Array(options).each do |option|
          - option_label, option_value = option.is_a?(Array) ? option : [option, option]
          option value=option_value selected=(option_value.to_s == value.to_s)
            = option_label
      = render(Example::IconComponent.new("chevron-down"))

  - else
    input.ex-input(type=type id=field_id name=name value=value placeholder=placeholder
      required=required disabled=disabled aria-describedby=described_by aria-invalid=aria_invalid)

  - if hint.present?
    span.ex-hint id="#{field_id}-hint"
      = hint

  - if invalid?
    span.ex-error id="#{field_id}-error"
      = render(Example::IconComponent.new("triangle-alert", size: :sm))
      = error
