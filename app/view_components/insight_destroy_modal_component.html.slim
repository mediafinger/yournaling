dialog data-modal-target="dialog"
  article style="max-width: 550px;"
    header
      button aria-label="Close" rel="prev" data-action="click->modal#close" style="float: right;"
      h4 style="margin-bottom: 0;" = "Destroy #{@name.capitalize}"
    - if referenced?
      p style="color: var(--pico-del-color, #c00); font-weight: bold; margin-bottom: 0.5rem;"
        = "This #{@name} cannot be destroyed because it is still referenced by other content:"
      - if chronicles.any?
        p style="margin-bottom: 0.25rem; font-weight: bold;"
          | Chronicles:
        ul style="margin-top: 0; margin-bottom: 1rem;"
          - chronicles.each do |chronicle|
            li
              = link_to chronicle.name, current_team_chronicle_path(chronicle)
      - if memories.any?
        p style="margin-bottom: 0.25rem; font-weight: bold;"
          | Memories:
        ul style="margin-top: 0; margin-bottom: 1rem;"
          - memories.each do |memory|
            li
              = link_to memory.memo.truncate(60), current_team_memory_path(memory)
      footer
        div style="display: flex; gap: 0.5rem; justify-content: flex-end; align-items: center;"
          button.secondary type="button" data-action="click->modal#close" style="margin-bottom: 0;"
            | Close
          button.contrast disabled="disabled" style="margin-bottom: 0; opacity: 0.5; cursor: not-allowed;" title="Cannot destroy while referenced"
            | Destroy Insight
    - else
      p style="margin-bottom: 1.5rem;"
        = "Are you sure you want to destroy this #{@name}?"
      footer
        div style="display: flex; gap: 0.5rem; justify-content: flex-end; align-items: center;"
          = button_to "Destroy Insight", destroy_path, method: :delete, class: "contrast", style: "margin-bottom: 0;"
