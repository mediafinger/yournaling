.yui-record-header
  = content_tag(heading_tag, title, class: "yui-record-header__title")

  - unless @hide_actions
    .yui-record-header__actions
      - if show_open_button?
        = render Yui::ButtonComponent.new("Open", href: show_path, variant: :secondary, size: :sm)
      - if can_rewrite?
        = render Yui::ButtonComponent.new("Rewrite", href: edit_path, variant: :ghost, size: :sm)
      - if can_change_visibility?
        = render ContentVisibilityModalComponent.new(record: @record, user: current_user, team: current_team, member: current_member)
      - elsif show_visibility?
        = render Yui::BadgeComponent.new(visibility_label, variant: visibility_badge_variant)
