/ dt/dd fragment — the caller wraps a dl.yui-details.
dt Teams
dd
  ul.yui-stack.yui-stack--xs
    - user.teams.each do |team|
      - member = membership_for(team)
      li
        = link_to team.name, admin_team_path(team), class: "yui-link"
        = " "
        code.yui-code = team.id
        - if member
          = " · "
          = link_to member.roles.join(", "), admin_member_path(member), class: "yui-link"
