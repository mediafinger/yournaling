/ dt/dd fragment — the caller wraps a dl.ex-details.
dt Teams
dd
  ul.ex-stack.ex-stack--xs
    - user.teams.each do |team|
      - member = membership_for(team)
      li
        = link_to team.name, admin_team_path(team), class: "ex-link"
        = " "
        code.ex-code = team.id
        - if member
          = " · "
          = link_to member.roles.join(", "), admin_member_path(member), class: "ex-link"
