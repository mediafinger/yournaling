= render Yui::ModalComponent.new(title: "Change visibility", size: :sm) do |modal|
  - modal.with_trigger do
    button.ex-btn.ex-btn--ghost.ex-btn--sm type="button" title="Change visibility" aria-label="Change visibility"
      = render Yui::IconComponent.new("pencil", size: :sm)

  .ex-visibility-choices
    - visibility_states.each do |state|
      - if state == @record.visibility
        = render Yui::ButtonComponent.new("#{state.capitalize} ✓", variant: :primary, full_width: true, disabled: true)
      - else
        = button_to state.capitalize, current_team_content_visibility_path(@record), method: :patch, params: { visibility: state }, class: "ex-btn ex-btn--secondary ex-btn--block"
