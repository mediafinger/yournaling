= render Yui::CardComponent.new(id: helpers.dom_id(memory), accent: "gold", class: "yui-memory-card") do |card|
  - card.with_header do
    .yui-cluster.yui-cluster--between
      = render Yui::BadgeComponent.new("Memory", icon: "feather")
      - if actions?
        = render header_component
      - elsif static_meta.present?
        span.yui-meta = static_meta

  p.yui-memory-card__memo = memory.memo

  - attachments.each do |attachment|
    = render partial: insight_partial_path(attachment), locals: insight_partial_locals(attachment)
