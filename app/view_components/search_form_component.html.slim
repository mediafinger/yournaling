= render Yui::CardComponent.new do
  = form_with(url: url, method: :post, data: { controller: "search" }, html: { class: "ex-stack" }) do |form|
    = render Yui::HeadlineComponent.new(form_legend, level: 3)
    .ex-field
      = form.label :query, class: "ex-label"
      = form.text_field :query, value: query, class: "ex-input", minlength: 3, required: true, data: { search_target: "input", action: "input->search#validate" }
    .ex-field
      = form.label :klass_name, "Type", class: "ex-label"
      .ex-select-wrap
        = form.select :klass_name, klass_options, { selected: selected_klass }, { class: "ex-select" }
        = render Yui::IconComponent.new("chevron-down")
    = form.submit "Search", class: "ex-btn ex-btn--primary", data: { search_target: "submit" }, disabled: submit_disabled?
