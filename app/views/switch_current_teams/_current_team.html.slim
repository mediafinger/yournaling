= render Yui::CardComponent.new(id: dom_id(current_user_team), accent: (current_user_team == current_team ? "accent" : nil)) do
  dl.ex-details
    dt Name
    dd = current_user_team.name
    dt Roles
    dd = current_user_team.members.find_by(user: current_user).roles.to_sentence
  - if current_user_team == current_team
    .ex-cluster
      = button_to "Go solo", { controller: :switch_current_teams, action: :destroy, id: current_user_team.urlsafe_id }, method: :delete, class: "ex-btn ex-btn--secondary ex-btn--sm", id: current_user_team.urlsafe_id
      span.ex-text.ex-text--sm.ex-text--muted (unlink the selected team)
  - else
    = button_to "Select this team", switch_current_teams_path({ current_team: { team_id: current_user_team.id } }), method: :post, class: "ex-btn ex-btn--primary ex-btn--sm", id: current_user_team.urlsafe_id
