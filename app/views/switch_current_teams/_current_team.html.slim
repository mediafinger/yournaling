= render Yui::CardComponent.new(id: dom_id(current_user_team), accent: (current_user_team == current_team ? "accent" : nil)) do
  dl.yui-details
    dt Name
    dd = current_user_team.name
    dt Roles
    dd = current_user_team.members.find_by(user: current_user).roles.to_sentence
  - if current_user_team == current_team
    .yui-cluster
      = button_to "Go solo", { controller: :switch_current_teams, action: :destroy, id: current_user_team.urlsafe_id }, method: :delete, class: "yui-btn yui-btn--secondary yui-btn--sm", id: current_user_team.urlsafe_id
      span.yui-text.yui-text--sm.yui-text--muted (unlink the selected team)
  - else
    = button_to "Select this team", switch_current_teams_path({ current_team: { team_id: current_user_team.id } }), method: :post, class: "yui-btn yui-btn--primary yui-btn--sm", id: current_user_team.urlsafe_id
