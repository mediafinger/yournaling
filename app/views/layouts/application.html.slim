doctype html
html
  head
    title
      | Yournaling
    meta[name="viewport" content="width=device-width,initial-scale=1"]
    = csrf_meta_tags
    = csp_meta_tag
    / Pico, wrapped in a low-priority cascade layer (transitional — see design/tokens.css)
    = stylesheet_link_tag "pico/amber", "data-turbo-track": "reload"
    = stylesheet_link_tag "legacy", "data-turbo-track": "reload"
    = render "shared_partials/design_head"
    = javascript_importmap_tags
  body.ex-body
    header.ex-navbar-host data-controller="navbar"
      = render ApplicationNavComponent.new
    = render partial: "shared_partials/flash_notifications"
    main.ex-scope data-area="public"
      = yield
    button.ex-scroll-top data-controller="scroll-to-top" data-scroll-to-top-target="button" data-action="click->scroll-to-top#scrollToTop" aria-label="Scroll to top"
      = render Yui::IconComponent.new("arrow-up-right")
