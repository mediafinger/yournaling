.yui-narrow.yui-stack
  = render Yui::HeadlineComponent.new("Unfortunately you encountered an issue.", level: 2)
  p.yui-text
    strong Error:
    = " #{code} (#{status})"
  - if message.present?
    p.yui-text = message
  = link_to "Back to previous page", :back, class: "yui-btn yui-btn--secondary"
  - if status >= 500
    = render Yui::CalloutComponent.new(variant: :warning, title: "This looks like an issue on our side") do
      | We will look into it.
