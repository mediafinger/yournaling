#publishings data-controller="feed-refresh" data-feed-refresh-since-value=@newest_at data-feed-refresh-check-url-value=check_newer_pages_path data-feed-refresh-load-url-value=newer_pages_path
  #top_sentinel data-feed-refresh-target="topSentinel"
  #newer_posts_banner.newer-posts-banner data-feed-refresh-target="banner" hidden="" data-action="click->feed-refresh#loadNewer"
    span newer posts available, scroll up to load them
  #newer_posts_container data-feed-refresh-target="container"
  = turbo_frame_tag "publishings_page_#{@pagy.page}", target: "_top" do
    - if @publishings.any?
      .ex-record-grid
        - @publishings.each do |publishing|
          - if publishing.post_type == "Chronicle" && publishing.post.present?
            = render partial: "teams/chronicles/chronicle", locals: { team: publishing.team, chronicle: publishing.post }
          - elsif publishing.post_type == "Memory" && publishing.post.present?
            = render partial: "teams/memories/memory", locals: { team: publishing.team, memory: publishing.post }
      - if @pagy.next
        = turbo_frame_tag "publishings_page_#{@pagy.next}", src: root_path(page: @pagy.next), loading: :lazy, target: "_top"
    - elsif @pagy.page == 1
      = render EmptyStateComponent.new(icon: "📖", title: "No published stories or memories yet", description: "Explore the public journals and travel memories shared by teams around the world.")
