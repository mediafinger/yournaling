/ ------------------------------------------------------------------ Foundations / colour
= render(Example::SectionComponent.new(number: "01", title: "Foundations — Colour", anchor: "foundations", description: "A warm paper palette: cream grounds, cocoa ink, a terracotta accent and a muted gold. Every value is a CSS custom property, and the whole palette re-tunes itself for dark mode.")) do
  .ex-stack.ex-stack--lg
    div
      = render(Example::HeadlineComponent.new("Surfaces & ink", level: 4))
      .ex-grid style="margin-top: 1rem"
        = render(Example::SwatchComponent.new(name: "Paper", token: "--ex-paper"))
        = render(Example::SwatchComponent.new(name: "Surface", token: "--ex-surface"))
        = render(Example::SwatchComponent.new(name: "Surface · sunken", token: "--ex-surface-sunken"))
        = render(Example::SwatchComponent.new(name: "Ink", token: "--ex-ink"))
        = render(Example::SwatchComponent.new(name: "Ink · soft", token: "--ex-ink-soft"))
        = render(Example::SwatchComponent.new(name: "Ink · faint", token: "--ex-ink-faint"))
        = render(Example::SwatchComponent.new(name: "Border", token: "--ex-border"))
        = render(Example::SwatchComponent.new(name: "Border · strong", token: "--ex-border-strong"))
    div
      = render(Example::HeadlineComponent.new("Accent & semantic", level: 4))
      .ex-grid style="margin-top: 1rem"
        = render(Example::SwatchComponent.new(name: "Accent", token: "--ex-accent", value: "terracotta"))
        = render(Example::SwatchComponent.new(name: "Accent · strong", token: "--ex-accent-strong"))
        = render(Example::SwatchComponent.new(name: "Accent · soft", token: "--ex-accent-soft"))
        = render(Example::SwatchComponent.new(name: "Gold", token: "--ex-gold"))
        = render(Example::SwatchComponent.new(name: "Success", token: "--ex-success"))
        = render(Example::SwatchComponent.new(name: "Warning", token: "--ex-warning"))
        = render(Example::SwatchComponent.new(name: "Danger", token: "--ex-danger"))
        = render(Example::SwatchComponent.new(name: "Info", token: "--ex-info"))

/ ------------------------------------------------------------------ Typography
= render(Example::SectionComponent.new(number: "02", title: "Typography", anchor: "typography", description: "Fraunces — an old-style display serif — carries every headline and quotation. Inter handles UI text and labels. The scale is fluid: it breathes on wide screens and tightens on phones.")) do
  .ex-stack.ex-stack--lg
    div
      = render(Example::HeadlineComponent.new("The scale", level: 4))
      .ex-stack style="margin-top: 0.5rem"
        .ex-type-row
          span.ex-type-row__key Display
          span.ex-display Kept for good
        .ex-type-row
          span.ex-type-row__key H1
          h1.ex-h1 A year on the coast
        .ex-type-row
          span.ex-type-row__key H2
          h2.ex-h2 Everything we kept
        .ex-type-row
          span.ex-type-row__key H3
          h3.ex-h3 The northern beach at dusk
        .ex-type-row
          span.ex-type-row__key H4
          h4.ex-h4 Field notes, week four
        .ex-type-row
          span.ex-type-row__key Lead
          p.ex-lead Twelve months of small tides, collected walk by walk.
        .ex-type-row
          span.ex-type-row__key Body
          p.ex-text We left before sunrise and walked the whole length of the bay. The sand was still cold and the water was the colour of pewter.
        .ex-type-row
          span.ex-type-row__key Small
          p.ex-text.ex-text--sm.ex-text--muted Last edited 4 August 2024 · 2 min read

    div
      = render(Example::HeadlineComponent.new("Headline component", level: 4))
      .ex-stack style="margin-top: 1rem"
        = render(Example::SpecimenComponent.new('HeadlineComponent.new("...", level: 1, eyebrow: "Chronicle")')) do
          = render(Example::HeadlineComponent.new("A year on the coast", level: 1, eyebrow: "Chronicle"))
        = render(Example::SpecimenComponent.new('HeadlineComponent.new("...", level: 2, align: :center)')) do
          = render(Example::HeadlineComponent.new("Everything we kept", level: 2, align: :center))

    div
      = render(Example::HeadlineComponent.new("Inline & prose", level: 4))
      .ex-stack.ex-stack--sm style="margin-top: 1rem"
        p.ex-text
          ' Some phrases deserve
          => render(Example::EmphasisComponent.new("real weight"))
          ' and others are best said
          => render(Example::QuoteComponent.new("a little more quietly"))
          | .
        = render(Example::BlockquoteComponent.new("We travel to lose ourselves; we keep a journal to find ourselves again.", cite: "Field notes, vol. 3", variant: :card))
        = render(Example::ProseComponent.new) do
          p A <strong>Memory</strong> is the smallest unit here — a note, a photo, a place. Group them into an <em>Experience</em>, and a run of experiences becomes a <a href="#records">Chronicle</a>.
          ul
            li Write first, organise later.
            li Every record can be private, team-only, or public.

/ ------------------------------------------------------------------ Space & shape
= render(Example::SectionComponent.new(number: "03", title: "Space & shape", anchor: "space", description: "One 4-pt spacing scale and one family of radii keep rhythm consistent across every component.")) do
  .ex-grid.ex-grid--wide
    .ex-specimen
      span.ex-specimen__label spacing scale
      .ex-stack.ex-stack--xs
        - { "3xs" => "0.25rem", "2xs" => "0.5rem", "xs" => "0.75rem", "sm" => "1rem", "md" => "1.5rem", "lg" => "2rem", "xl" => "3rem" }.each do |name, size|
          .ex-ruler
            span style="width: 4rem" = "--#{name}"
            span.ex-ruler__bar style="width: #{size}"
            span = size
    .ex-specimen
      span.ex-specimen__label radii
      .ex-specimen__row
        - { "sm" => "var(--ex-radius-sm)", "md" => "var(--ex-radius-md)", "lg" => "var(--ex-radius-lg)", "pill" => "var(--ex-radius-pill)" }.each do |name, value|
          .ex-stack.ex-stack--xs style="align-items: center"
            .ex-radius-demo style="border-radius: #{value}"
            span.ex-swatch__value = name
    .ex-specimen
      span.ex-specimen__label elevation
      .ex-specimen__row
        - %w[xs sm md lg].each do |level|
          .ex-stack.ex-stack--xs style="align-items: center"
            div style="width: 4.5rem; height: 4.5rem; border-radius: var(--ex-radius-md); background: var(--ex-surface); box-shadow: var(--ex-shadow-#{level})"
            span.ex-swatch__value = "shadow-#{level}"

/ ------------------------------------------------------------------ Buttons
= render(Example::SectionComponent.new(number: "04", title: "Buttons", anchor: "buttons", description: "One ButtonComponent. Pass a variant and a size; add a leading or trailing icon; give it an href to render as a link. Pill-shaped, quietly animated on hover.")) do
  .ex-stack.ex-stack--lg
    = render(Example::SpecimenComponent.new("variant: :primary | :secondary | :warning | :danger | :ghost")) do
      = render(Example::ButtonComponent.new("Primary", variant: :primary))
      = render(Example::ButtonComponent.new("Secondary", variant: :secondary))
      = render(Example::ButtonComponent.new("Warning", variant: :warning))
      = render(Example::ButtonComponent.new("Danger", variant: :danger))
      = render(Example::ButtonComponent.new("Ghost", variant: :ghost))
    = render(Example::SpecimenComponent.new("size: :sm | :md | :lg")) do
      = render(Example::ButtonComponent.new("Small", size: :sm))
      = render(Example::ButtonComponent.new("Medium", size: :md))
      = render(Example::ButtonComponent.new("Large", size: :lg))
    = render(Example::SpecimenComponent.new("icon: / trailing_icon: / disabled: / href:")) do
      = render(Example::ButtonComponent.new("New memory", icon: "plus"))
      = render(Example::ButtonComponent.new("Continue", variant: :secondary, trailing_icon: "arrow-right"))
      = render(Example::ButtonComponent.new("Delete", variant: :danger, icon: "trash"))
      = render(Example::ButtonComponent.new("Disabled", disabled: true))
      = render(Example::ButtonComponent.new("As a link", href: "#buttons", variant: :ghost, trailing_icon: "arrow-up-right"))
    = render(Example::SpecimenComponent.new("full_width: true")) do
      div style="flex: 1; min-width: 16rem"
        = render(Example::ButtonComponent.new("Save this memory", full_width: true))

/ ------------------------------------------------------------------ Links
= render(Example::SectionComponent.new(number: "05", title: "Links", anchor: "links", description: "Three link treatments for three jobs: inline, muted, and a standalone call-to-action with a nudging arrow.")) do
  .ex-stack.ex-stack--sm
    = render(Example::SpecimenComponent.new("variant: :default")) do
