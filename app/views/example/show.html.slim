/ ------------------------------------------------------------------ Hero
header.ex-showcase__hero
  .ex-container
    .ex-stack.ex-stack--sm style="max-width: 46rem"
      = render(Example::EyebrowComponent.new("Yournaling · Design Language"))
      h1.ex-display Warm, editorial, and built to last.
      p.ex-lead
        ' A self-contained system of tokens and
        => render(Example::QuoteComponent.new("ViewComponents"))
        | — typography, colour, spacing, buttons, forms, cards — used to give every page of Yournaling one calm, considered voice.
      .ex-cluster style="margin-top: 0.5rem"
        = render(Example::ButtonComponent.new("Start with the tokens", href: "#foundations", variant: :primary, trailing_icon: "arrow-right"))
        = render(Example::ButtonComponent.new("Jump to the records", href: "#records", variant: :secondary))

