/ ------------------------------------------------------------------ Badges & tags
= render(Example::SectionComponent.new(number: "06", title: "Badges & tags", anchor: "badges", description: "Badges state status in a word. Tags are pill-shaped chips for places, keywords and filters — link them or make them removable.")) do
  .ex-stack.ex-stack--lg
