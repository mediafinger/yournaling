/ ------------------------------------------------------------------ Icons
= render(Example::SectionComponent.new(number: "07", title: "Icons", anchor: "icons", description: "A small, consistent, stroke-based set. One IconComponent, three sizes, currentColor throughout — so an icon always matches the text beside it.")) do
  .ex-grid
    - Example::IconComponent::PATHS.each_key do |name|
      .ex-specimen.ex-specimen--center
        .ex-specimen__row
          = render(Example::IconComponent.new(name, size: :lg))
        span.ex-specimen__label = name

/ ------------------------------------------------------------------ Forms
= render(Example::SectionComponent.new(number: "08", title: "Forms", anchor: "forms", description: "FieldComponent bundles a label, control, hint and error into one accessible unit. Inputs, textareas and selects share a border, focus ring and disabled state.")) do
  .ex-grid.ex-grid--wide
    .ex-stack
      = render(Example::FieldComponent.new(label: "Title", name: "memory[title]", required: true, placeholder: "A short name for this memory", value: "Sand dollar, unbroken"))
      = render(Example::FieldComponent.new(label: "Email", name: "email", type: "email", value: "andy@", error: "That address looks incomplete."))
      = render(Example::FieldComponent.new(label: "Notes", name: "memory[notes]", as: :textarea, hint: "Markdown is supported.", value: "We found it right where the path meets the water."))
    .ex-stack
      = render(Example::FieldComponent.new(label: "Visibility", name: "memory[visibility]", as: :select, value: "team", options: [["Private — only me", "private"], ["Team — our shared journal", "team"], ["Public — anyone with the link", "public"]]))
      .ex-field
        = render(Example::LabelComponent.new("Attach to", for: "attach", optional: true))
        .ex-stack.ex-stack--xs
          = render(Example::ChoiceComponent.new("This experience", name: "attach", type: :radio, value: "exp", checked: true))
          = render(Example::ChoiceComponent.new("A new experience", name: "attach", type: :radio, value: "new"))
      = render(Example::ChoiceComponent.new("Let the team comment on this memory", name: "comments", type: :checkbox, hint: "You can turn this off later.", checked: true))
      = render(Example::FieldComponent.new(label: "Location", name: "loc", disabled: true, value: "Locked while syncing…"))
    .ex-specimen
      span.ex-specimen__label dropdown menu
      .ex-dropdown
        a.ex-dropdown__item href="#forms"
          = render(Example::IconComponent.new("pencil", size: :sm))
          | Edit memory
        a.ex-dropdown__item href="#forms"
          = render(Example::IconComponent.new("bookmark", size: :sm))
          | Add to a chronicle
        a.ex-dropdown__item href="#forms"
          = render(Example::IconComponent.new("link", size: :sm))
          | Copy public link
        .ex-dropdown__sep
        button.ex-dropdown__item type="button" style="color: var(--ex-danger)"
          = render(Example::IconComponent.new("trash", size: :sm))
          | Delete

/ ------------------------------------------------------------------ Feedback
= render(Example::SectionComponent.new(number: "09", title: "Feedback", anchor: "feedback", description: "Callouts carry inline guidance and confirmations. Four tones, each with a matching icon and tint.")) do
  .ex-stack.ex-stack--sm
    = render(Example::CalloutComponent.new(variant: :info, title: "Drafts autosave")) do
      | This memory is saved to your account every few seconds while you write.
    = render(Example::CalloutComponent.new(variant: :success, title: "Memory saved")) do
      | It now appears in the timeline for The Coast Year.
    = render(Example::CalloutComponent.new(variant: :warning, title: "This experience is still private")) do
      | Only you can see it. Change its visibility to share it with the team.
    = render(Example::CalloutComponent.new(variant: :danger, title: "Deleting a chronicle is permanent")) do
      | Its memories stay, but the timeline and its order are lost.

/ ------------------------------------------------------------------ Surfaces
- surfaces_desc = "CardComponent is the one container: slots for media, header and footer; variants for elevation and emphasis; an optional accent stripe. Figures and avatars round out the set."
= render(Example::SectionComponent.new(number: "10", title: "Surfaces", anchor: "surfaces", description: surfaces_desc)) do
  .ex-stack.ex-stack--lg
    .ex-grid.ex-grid--wide
      = render(Example::CardComponent.new(variant: :default)) do |card|
        - card.with_header do
          = render(Example::HeadlineComponent.new("Default", level: 4))
        p.ex-text.ex-text--sm A hairline border on a plain surface. The everyday card.
      = render(Example::CardComponent.new(variant: :elevated)) do |card|
        - card.with_header do
          = render(Example::HeadlineComponent.new("Elevated", level: 4))
        p.ex-text.ex-text--sm Borderless, lifted with a soft warm shadow. For things that float.
      = render(Example::CardComponent.new(variant: :outline)) do |card|
        - card.with_header do
          = render(Example::HeadlineComponent.new("Outline", level: 4))
        p.ex-text.ex-text--sm Transparent fill, firmer border. Quiet until you need it.
      = render(Example::CardComponent.new(variant: :sunken, accent: "accent")) do |card|
        - card.with_header do
          = render(Example::HeadlineComponent.new("Sunken + accent", level: 4))
        p.ex-text.ex-text--sm Recessed tone with a terracotta stripe to mark it out.
    .ex-grid.ex-grid--wide
      = render(Example::FigureComponent.new(src: photo, alt: "The northern beach at dusk", caption: "Day 4 — the northern beach", ratio: "3/2"))
      .ex-specimen
        span.ex-specimen__label AvatarComponent — initials & sizes
        .ex-specimen__row
          = render(Example::AvatarComponent.new(name: "Mira Kessler", size: :sm))
          = render(Example::AvatarComponent.new(name: "Andreas Finger", size: :md))
          = render(Example::AvatarComponent.new(name: "Jonas Reeve", size: :lg))
          = render(Example::AvatarComponent.new(name: "The Coast Year", size: :xl))

