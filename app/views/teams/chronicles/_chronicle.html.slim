article id= dom_id(chronicle)
  header
    h3 = chronicle.name
    p
      small
        strong Dates: 
        = chronicle.start_date
        - if chronicle.end_date.present?
          |  – 
          = chronicle.end_date

  p
    strong Notice:
    = chronicle.notice

  - if chronicle.chronicle_entries.any?
    section
      h4 Entries
      - chronicle.chronicle_entries.each do |chronicle_entry|
        - if chronicle_entry.entry.is_a?(Picture)
          = render partial: "teams/pictures/picture", locals: { team:, picture: chronicle_entry.entry }
        - elsif chronicle_entry.entry.is_a?(Location)
          = render partial: "teams/locations/location", locals: { team:, location: chronicle_entry.entry }
        - elsif chronicle_entry.entry.is_a?(Thought)
          = render partial: "teams/thoughts/thought", locals: { team:, thought: chronicle_entry.entry }
        - elsif chronicle_entry.entry.is_a?(Weblink)
          = render partial: "teams/weblinks/weblink", locals: { team:, weblink: chronicle_entry.entry }
        - elsif chronicle_entry.entry.is_a?(Memory)
          = render partial: "teams/memories/memory", locals: { team:, memory: chronicle_entry.entry }

  footer
    - if action_name != "show"
      = link_to "Show this chronicle", team_chronicle_path(team, chronicle), role: "button"
