article.yournal-card.chronicle-card id= dom_id(chronicle)
  header.card-header
    span.card-badge 📖 Chronicle
    - if chronicle.start_date.present?
      small.text-muted
        = chronicle.start_date
        - if chronicle.end_date.present?
          |  – 
          = chronicle.end_date

  h3 = chronicle.name

  p
    strong Notice: 
    = chronicle.notice

  - is_chronicle_show = (controller_name == "chronicles" && action_name == "show")
  - if local_assigns[:full] || is_chronicle_show
    - if chronicle.entries.any?
      section.chronicle-timeline-track
        h4 Entries
        - chronicle.entries.each do |chronicle_entry|
          .chronicle-entry-item
            = render ChronicleEntryComponent.new(chronicle_entry: chronicle_entry, scope: "team", team: team)
  - elsif chronicle.first_picture.present?
    p
      = render partial: "teams/pictures/picture", locals: { team:, picture: chronicle.first_picture }

  footer
    - if !local_assigns[:full] && !is_chronicle_show
      = link_to "Show this chronicle", team_chronicle_path(team, chronicle), role: "button"
