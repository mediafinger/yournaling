doctype html
html
  head
    meta charset="utf-8"
    meta name="viewport" content="width=device-width,initial-scale=1"
    title
      = "#{@picture.name} · Yournaling"
    = csp_meta_tag
    = render "shared_partials/design_head"
  body.yui-body
    main.yui-scope.yui-narrow.yui-stack
      = render Yui::HeadlineComponent.new(@picture.name.presence || "Picture", level: 1)
      p.yui-text.yui-text--sm.yui-text--muted
        = "#{@picture.width} × #{@picture.height} · #{number_to_human_size(@picture.megabytes.megabytes)} · #{@picture.content_type} · #{@picture.filename}"
      = image_tag(@picture.file, alt: @picture.name)
