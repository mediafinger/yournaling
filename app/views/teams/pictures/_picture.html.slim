article id= dom_id(picture)
  - is_picture_controller = (controller_name == "pictures" || controller_path.to_s.end_with?("pictures"))
  - if is_picture_controller && action_name == "show"
    p
      strong = picture.name
      - if picture.date
        |  (
        = picture.date
        | )
    p
      |  Original:
      = picture.width
      |  x
      = picture.height
      |  |
      = number_to_human_size(picture.megabytes.megabytes)
      |  |
      = picture.content_type
      |  |
      = picture.filename
    p
      = link_to image_tag(picture.large, style: "max-height: 30rem; width: auto;"), team_picture_only_path(team_id: team.to_param, id: picture.to_param), target: "_blank", rel: "noopener noreferrer"
  - else
    = render PictureLightboxComponent.new(picture: picture, team: team)
