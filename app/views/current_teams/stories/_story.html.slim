- if local_assigns[:hide_actions]
  article.yui-stack.yui-stack--sm id=dom_id(story)
    = render Yui::HeadlineComponent.new(story.name, level: 4)
    .yui-prose = markdown(story.content)
- else
  = render Yui::CardComponent.new(id: dom_id(story)) do |card|
    - card.with_header do
      = render ManageHeaderComponent.new(record: story)
    - card.with_footer do
      = render RecordFooterComponent.new(record: story, scope: :manage)
    .yui-prose = markdown(story.content)
