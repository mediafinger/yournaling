.yui-narrow.yui-stack
  - if current_team == @story.team
    = render partial: "form", locals: { story: @story, form_legend: "Edit story" }
  .yui-cluster
    = render Yui::ButtonComponent.new("Open", href: current_team_story_path(@story), variant: :secondary)
    - if current_team == @story.team
      = render InsightDestroyModalComponent.new(insight: @story, name: "story")
