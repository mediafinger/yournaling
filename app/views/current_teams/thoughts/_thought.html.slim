article id= dom_id(thought)
  header style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1rem;"
    div
      h4 style="margin-bottom: 0.25rem;" Thought
      p style="margin-bottom: 0;"
        small
          - if thought.date.present?
            strong Date:&nbsp;
            = thought.date
            | &nbsp;|&nbsp;
          strong Visibility:&nbsp;
          = thought.visibility
          - unless local_assigns[:hide_actions]
            = render ContentVisibilityDropdownComponent.new(record: thought)

    - unless local_assigns[:hide_actions]
      div style="display: flex; gap: 0.5rem; flex-shrink: 0;"
        - if action_name != "show"
          = link_to "Open", current_team_thought_path(thought), role: "button", class: "outline", style: "padding: 0.25rem 0.6rem; font-size: 0.8rem; margin-bottom: 0;"
        - if respond_to?(:current_user) && current_user.present? && current_team == thought.team && allowed_to?(:update?, thought)
          = link_to "Rewrite", edit_current_team_thought_path(thought), role: "button", class: "outline secondary", style: "padding: 0.25rem 0.6rem; font-size: 0.8rem; margin-bottom: 0;"

  p
    strong Text:
    br
    = thought.text
