- if local_assigns[:hide_actions]
  div id= dom_id(picture)
    = render PictureLightboxComponent.new(picture: picture, team: current_team)
- else
  = render Yui::CardComponent.new(id: dom_id(picture)) do
    = render ManageHeaderComponent.new(record: picture, hide_actions: false)

    - is_picture_show = (controller_name == "pictures" || controller_path.to_s.end_with?("pictures")) && action_name == "show"
    - if is_picture_show
      dl.yui-details
        dt Original
        dd = "#{picture.width} × #{picture.height} · #{number_to_human_size(picture.megabytes.megabytes)} · #{picture.content_type} · #{picture.filename}"
      - original_href = picture.visibility == "published" ? team_picture_only_path(current_team, picture) : rails_blob_path(picture.file)
      = link_to original_href, target: "_blank", rel: "noopener noreferrer", class: "yui-media-link" do
        = image_tag(picture.large, alt: picture.name, class: "yui-lightbox-full")
    - else
      = render PictureLightboxComponent.new(picture: picture, team: current_team)
