= render Yui::CardComponent.new(id: dom_id(member)) do |card|
  - card.with_header do
    = render ManageHeaderComponent.new(record: member, hide_actions: local_assigns[:hide_actions])
  - unless local_assigns[:hide_actions]
    - card.with_footer do
      = render RecordFooterComponent.new(record: member, scope: :manage, show_rewrite: false, show_visibility: false)
  dl.yui-details
    dt Roles
    dd = member.roles.to_sentence
