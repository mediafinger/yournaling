= render Yui::CardComponent.new do
  = form_with(model: [:current_team, weblink], builder: YuiFormBuilder, html: { class: "ex-stack" }) do |form|
    = render Yui::HeadlineComponent.new(form_legend, level: 3)
    = render partial: "shared_partials/form_validation_errors", locals: { record: weblink }
    = form.text_field :name, label: "Link name", required: true, placeholder: "e.g. Route Planning Guide"
    = form.url_field :url, label: "URL", required: true, placeholder: "e.g. https://route-planner.example.com"
    = form.date_field :date
    = form.text_area :description, label: "Description", rows: 3, hint: "Optional — brief notes or context about this link."
    = form.submit
