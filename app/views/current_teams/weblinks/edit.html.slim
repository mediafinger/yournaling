div data-controller="modal"
  - if current_team == @weblink.team
    = render partial: "form", locals: { weblink: @weblink, form_legend: "Edit weblink" }
  div style="display: flex; gap: 0.5rem; align-items: center; margin-top: 1rem;"
    = link_to "Show this weblink", current_team_weblink_path(@weblink), role: "button"
    - if current_team == @weblink.team
      button type="button" class="secondary" data-action="click->modal#open" style="margin-bottom: 0;"
        | Destroy this weblink

  - if current_team == @weblink.team
    = render InsightDestroyModalComponent.new(insight: @weblink, name: "weblink")
