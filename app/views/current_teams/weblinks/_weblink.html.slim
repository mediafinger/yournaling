article id= dom_id(weblink)
  header style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1rem;"
    div
      h4 style="margin-bottom: 0.25rem;" = weblink.name
      p style="margin-bottom: 0;"
        small
          - if weblink.date.present?
            strong Date:&nbsp;
            = weblink.date
            | &nbsp;|&nbsp;
          strong Visibility:&nbsp;
          = weblink.visibility
          - unless local_assigns[:hide_actions]
            = render ContentVisibilityDropdownComponent.new(record: weblink)

    - unless local_assigns[:hide_actions]
      div style="display: flex; gap: 0.5rem; flex-shrink: 0;"
        - if action_name != "show"
          = link_to "Open", current_team_weblink_path(weblink), role: "button", class: "outline", style: "padding: 0.25rem 0.6rem; font-size: 0.8rem; margin-bottom: 0;"
        - if respond_to?(:current_user) && current_user.present? && current_team == weblink.team && allowed_to?(:update?, weblink)
          = link_to "Rewrite", edit_current_team_weblink_path(weblink), role: "button", class: "outline secondary", style: "padding: 0.25rem 0.6rem; font-size: 0.8rem; margin-bottom: 0;"

  p
    strong Url:
    br
    = render ExternalLinkComponent.new(url: weblink.url, text: weblink.url)

  - if weblink.description.present?
    p
      strong Description:
      br
      = weblink.description
