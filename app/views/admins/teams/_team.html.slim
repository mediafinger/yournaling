= render Yui::CardComponent.new(id: dom_id(team)) do
  = render Yui::HeadlineComponent.new(team.name, level: 3)
  dl.yui-details
    = render AdminShowTeamMembersComponent.new(team: team)
    = render AdminShowMetaInformationComponent.new(record: team)
  = render AdminActionsComponent.new(record: team, name: "team")
