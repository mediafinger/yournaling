- detailed = local_assigns.fetch(:detailed, controller_name == "pictures" && action_name == "show")
= render Yui::CardComponent.new(id: dom_id(picture)) do
  = render Yui::HeadlineComponent.new(picture.name.presence || "Picture", level: 3)

  - if detailed
    - if picture.visibility == "published"
      = link_to image_tag(picture.large), team_picture_only_path(picture.team, picture), target: "_blank", rel: "noopener noreferrer", class: "yui-media-link"
    - else
      = link_to image_tag(picture.large), rails_blob_path(picture.file), target: "_blank", rel: "noopener noreferrer", class: "yui-media-link"
  - else
    = link_to image_tag(picture.preview), admin_picture_path(picture), class: "yui-media-link"

  dl.yui-details
    - if picture.date
      dt Date
      dd = picture.date
    dt Visibility
    dd = picture.visibility
    - if detailed
      dt Original
      dd = "#{picture.width} × #{picture.height} · #{number_to_human_size(picture.megabytes.megabytes)} · #{picture.content_type} · #{picture.filename}"
    = render AdminShowTeamComponent.new(team: picture.team)
    = render AdminShowMetaInformationComponent.new(record: picture)

  - unless local_assigns[:hide_actions]
    = render AdminActionsComponent.new(record: picture, name: "picture")
