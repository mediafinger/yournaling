article id= dom_id(chronicle)
  header
    h3 = chronicle.name
    p
      small
        strong Dates: 
        = chronicle.start_date
        - if chronicle.end_date.present?
          |  – 
          = chronicle.end_date
        |  | 
        strong Visibility: 
        = chronicle.visibility

  p
    strong Notice:
    = chronicle.notice

  - if chronicle.chronicle_entries.any?
    section
      h4 Entries
      - chronicle.chronicle_entries.each do |chronicle_entry|
        - if chronicle_entry.entry.is_a?(Picture)
          = render partial: "admins/pictures/picture", locals: { picture: chronicle_entry.entry }
        - elsif chronicle_entry.entry.is_a?(Location)
          = render partial: "admins/locations/location", locals: { location: chronicle_entry.entry }
        - elsif chronicle_entry.entry.is_a?(Thought)
          = render partial: "admins/thoughts/thought", locals: { thought: chronicle_entry.entry }
        - elsif chronicle_entry.entry.is_a?(Weblink)
          = render partial: "admins/weblinks/weblink", locals: { weblink: chronicle_entry.entry }
        - elsif chronicle_entry.entry.is_a?(Memory)
          = render partial: "admins/memories/memory", locals: { memory: chronicle_entry.entry } if lookup_context.template_exists?("admins/memories/memory", [], true)

  hr
  = render AdminShowTeamComponent.new(team: chronicle.team)
  = render AdminShowMetaInformationComponent.new(record: chronicle)
  = render AdminActionsComponent.new(record: chronicle, name: "chronicle")
